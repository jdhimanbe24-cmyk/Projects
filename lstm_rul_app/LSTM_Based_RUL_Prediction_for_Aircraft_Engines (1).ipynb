        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import tensorflow as tf\n",
        "import random\n",
        "import joblib\n",
        "import json\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",
        "\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense, Dropout, Input, Bidirectional\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ReduceLROnPlateau\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "from tensorflow.keras.regularizers import l2\n",
        "\n",
        "# =========================\n",
        "# REPRODUCIBILITY\n",
        "# =========================\n",
        "np.random.seed(42)\n",
        "tf.random.set_seed(42)\n",
        "random.seed(42)\n",
        "\n",
        "# =========================\n",
        "# PARAMETERS\n",
        "# =========================\n",
        "SEQ_LENGTH = 30\n",
        "MAX_RUL = 125\n",
        "STRIDE = 1\n",
        "\n",
        "# =========================\n",
        "# COLUMN NAMES\n",
        "# =========================\n",
        "cols = ['engine_id', 'cycle'] + \\\n",
        "       [f'op_setting_{i}' for i in range(1, 4)] + \\\n",
        "       [f'sensor_{i}' for i in range(1, 22)]\n",
        "\n",
        "# =========================\n",
        "# HUBER LOSS (NUMPY VERSION FOR TEST)\n",
        "# =========================\n",
        "def huber_loss_np(y_true, y_pred, delta=1.0):\n",
        "    error = y_true - y_pred\n",
        "    is_small_error = np.abs(error) <= delta\n",
        "\n",
        "    squared_loss = 0.5 * error**2\n",
        "    linear_loss = delta * (np.abs(error) - 0.5 * delta)\n",
        "\n",
        "    return np.mean(np.where(is_small_error, squared_loss, linear_loss))\n",
        "\n",
        "# =========================\n",
        "# SEQUENCE FUNCTION\n",
        "# =========================\n",
        "def create_sequences(df, seq_length, feature_cols, stride=1):\n",
        "    X, y = [], []\n",
        "\n",
        "    for engine_id in df['engine_id'].unique():\n",
        "        engine_data = df[df['engine_id'] == engine_id].sort_values('cycle')\n",
        "\n",
        "        values = engine_data[feature_cols].values\n",
        "        rul = engine_data['RUL'].values\n",
        "\n",
        "        for i in range(0, len(engine_data) - seq_length, stride):\n",
        "            X.append(values[i:i+seq_length])\n",
        "            y.append(rul[i+seq_length-1])\n",
        "\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "# =========================\n",
        "# PLOTTING FUNCTION\n",
        "# =========================\n",
        "def plot_results(y_true, y_pred, history, name):\n",
        "\n",
        "    plt.figure(figsize=(10,4))\n",
        "    plt.plot(y_true[:200], label='Actual')\n",
        "    plt.plot(y_pred[:200], label='Predicted')\n",
        "    plt.title(f\"{name} - Prediction vs Actual\")\n",
        "    plt.legend()\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "    plt.figure(figsize=(5,5))\n",
        "    plt.scatter(y_true, y_pred, alpha=0.4)\n",
        "    plt.plot([0, MAX_RUL], [0, MAX_RUL], linestyle='--')\n",
        "    plt.title(f\"{name} - Actual vs Predicted\")\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "    residuals = y_true - y_pred\n",
        "    plt.figure(figsize=(6,4))\n",
        "    plt.scatter(y_pred, residuals, alpha=0.4)\n",
        "    plt.axhline(0, linestyle='--')\n",
        "    plt.title(f\"{name} - Residuals\")\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "    plt.figure(figsize=(6,4))\n",
        "    plt.hist(residuals, bins=50)\n",
        "    plt.title(f\"{name} - Error Distribution\")\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "    plt.figure(figsize=(8,4))\n",
        "    plt.plot(history.history['mae'], label='Train MAE')\n",
        "    plt.plot(history.history['val_mae'], label='Val MAE')\n",
        "    plt.legend()\n",
        "    plt.title(f\"{name} Training Curve\")\n",
        "    plt.grid()\n",
        "    plt.show()\n",
        "\n",
        "# =========================\n",
        "# MAIN FUNCTION\n",
        "# =========================\n",
        "def run_dataset(name):\n",
        "\n",
        "    print(f\"\\n🚀 Running {name}...\")\n",
        "\n",
        "    # LOAD TRAIN\n",
        "    df_train = pd.read_csv(f'/content/train_{name}.txt', sep=r'\\s+', header=None)\n",
        "    df_train = df_train.iloc[:, :26]\n",
        "    df_train.columns = cols\n",
        "\n",
        "    df_train['RUL'] = df_train.groupby('engine_id')['cycle'].transform('max') - df_train['cycle']\n",
        "    df_train['RUL'] = df_train['RUL'].clip(upper=MAX_RUL)\n",
        "    df_train['RUL'] = df_train['RUL'] / MAX_RUL\n",
        "\n",
        "    # LOAD TEST\n",
        "    df_test = pd.read_csv(f'/content/test_{name}.txt', sep=r'\\s+', header=None)\n",
        "    df_test = df_test.iloc[:, :26]\n",
        "    df_test.columns = cols\n",
        "\n",
        "    rul = pd.read_csv(f'/content/RUL_{name}.txt', sep=r'\\s+', header=None)\n",
        "    rul.columns = ['RUL']\n",
        "\n",
        "    max_cycle = df_test.groupby('engine_id')['cycle'].max().reset_index()\n",
        "    max_cycle.columns = ['engine_id', 'max_cycle']\n",
        "    max_cycle['RUL'] = rul['RUL']\n",
        "\n",
        "    df_test = df_test.merge(max_cycle, on='engine_id', how='left')\n",
        "    df_test['RUL'] = df_test['RUL'] + (df_test['max_cycle'] - df_test['cycle'])\n",
        "\n",
        "    df_test['RUL'] = df_test['RUL'].clip(upper=MAX_RUL)\n",
        "    df_test['RUL'] = df_test['RUL'] / MAX_RUL\n",
        "\n",
        "    # SCALING\n",
        "    feature_cols = df_train.columns.drop(['engine_id', 'cycle', 'RUL'])\n",
        "\n",
        "    scaler = StandardScaler()\n",
        "    df_train[feature_cols] = scaler.fit_transform(df_train[feature_cols])\n",
        "    df_test[feature_cols] = scaler.transform(df_test[feature_cols])\n",
        "\n",
        "    # SEQUENCES\n",
        "    X_train, y_train = create_sequences(df_train, SEQ_LENGTH, feature_cols, STRIDE)\n",
        "    X_test, y_test = create_sequences(df_test, SEQ_LENGTH, feature_cols, STRIDE)\n",
        "\n",
        "    print(\"Train shape:\", X_train.shape)\n",
        "\n",
        "    # MODEL\n",
        "    model = Sequential([\n",
        "        Input(shape=(X_train.shape[1], X_train.shape[2])),\n",
        "\n",
        "        Bidirectional(LSTM(96, return_sequences=True, kernel_regularizer=l2(1e-4))),\n",
        "        Dropout(0.3),\n",
        "\n",
        "        Bidirectional(LSTM(64, kernel_regularizer=l2(1e-4))),\n",
        "        Dropout(0.3),\n",
        "\n",
        "        Dense(64, activation='relu'),\n",
        "        Dense(1)\n",
        "    ])\n",
        "\n",
        "    model.compile(\n",
        "        optimizer=Adam(learning_rate=0.0003),\n",
        "        loss='huber',\n",
        "        metrics=['mae']\n",
        "    )\n",
        "\n",
        "    # CALLBACKS\n",
        "    early_stop = EarlyStopping(monitor='val_mae', patience=6, restore_best_weights=True)\n",
        "\n",
        "    lr_reduce = ReduceLROnPlateau(\n",
        "        monitor='val_mae',\n",
        "        factor=0.5,\n",
        "        patience=3,\n",
        "        min_lr=1e-6,\n",
        "        verbose=1\n",
        "    )\n",
        "\n",
        "    # TRAIN\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        epochs=40,\n",
        "        batch_size=64,\n",
        "        validation_split=0.2,\n",
        "        shuffle=False,\n",
        "        callbacks=[early_stop, lr_reduce],\n",
        "        verbose=1\n",
        "    )\n",
        "\n",
        "    # PREDICT\n",
        "    y_pred = model.predict(X_test).flatten()\n",
        "\n",
        "    y_pred_real = y_pred * MAX_RUL\n",
        "    y_test_real = y_test * MAX_RUL\n",
        "\n",
        "    # =========================\n",
        "    # FINAL METRICS\n",
        "    # =========================\n",
        "    mae = mean_absolute_error(y_test_real, y_pred_real)\n",
        "    rmse = np.sqrt(mean_squared_error(y_test_real, y_pred_real))\n",
        "    huber = huber_loss_np(y_test_real, y_pred_real)\n",
        "\n",
        "    print(f\"\\n📊 {name} FINAL RESULTS:\")\n",
        "    print(f\"Test MAE (cycles): {mae:.2f}\")\n",
        "    print(f\"Test RMSE (cycles): {rmse:.2f}\")\n",
        "    print(f\"Test Huber Loss: {huber:.4f}\")\n",
        "\n",
        "    # SAVE\n",
        "    results_df = pd.DataFrame({\n",
        "        \"Actual_RUL\": y_test_real,\n",
        "        \"Predicted_RUL\": y_pred_real\n",
        "    })\n",
        "    results_df.to_csv(f\"/content/results_{name}.csv\", index=False)\n",
        "\n",
        "    model.save(f\"/content/bilstm_{name}.keras\")\n",
        "    joblib.dump(scaler, f\"/content/scaler_{name}.pkl\")\n",
        "    json.dump(list(feature_cols), open(f\"/content/features_{name}.json\", \"w\"))\n",
        "\n",
        "    plot_results(y_test_real, y_pred_real, history, name)\n",
        "\n",
        "    return mae, model, scaler, feature_cols\n",
        "\n",
        "# =========================\n",
        "# RUN\n",
        "# =========================\n",
        "datasets = ['FD001', 'FD002', 'FD003', 'FD004']\n",
        "\n",
        "results = {}\n",
        "\n",
        "for ds in datasets:\n",
        "    mae = run_dataset(ds)\n",
        "    results[ds] = mae\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
