        "\n",
        "    # Load feature columns\n",
        "    feature_cols = json.load(open(f\"/content/features_{name}.json\"))\n",
        "\n",
        "    print(\"✅ Model, scaler, and features loaded successfully!\")\n",
        "\n",
        "    return model, scaler, feature_cols"
